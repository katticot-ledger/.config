[gpg]
	format = ssh
[commit]
	gpgsign = true
[user]
	email = sagara911@gmail.com
	name = katticot
	signingkey = /Users/keita/.ssh/id_ed25519.pub
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	co = checkout
	cob = checkout -b
	tidy-up = !git checkout main && git branch | grep -v "main" | xargs git branch -D
	gck = checkout
[core]
	editor = nvim
	excludesfile = /Users/keita/.config/.gitignore
	sshCommand = ssh
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[init]
	defaultBranch = main
[pull]
	rebase = false
	excludesfile = /Users/keita/.config/.gitignore
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[diff "difft"]
	command = difft --color=always
[gpg "ssh"]
	allowedSignersFile = /Users/keita/.ssh/allowed_signers
