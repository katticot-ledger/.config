# ─── Font ──────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 20
adjust-cell-height = 25%
adjust-cell-width = 0%

# Ligatures (calt & liga are on by default; enable ss19)
font-feature = ss19

# Thicken font strokes (macOS only, matches WezTerm's WebGpu rendering)
font-thicken = true
font-thicken-strength = 80

# ─── Theme ─────────────────────────────────────────────────────────────────────
theme = TokyoNight

# ─── Window ────────────────────────────────────────────────────────────────────
background-opacity = 0.96
background-blur = 20

window-padding-x = 16
window-padding-y = 12
window-padding-balance = true

# No title bar — clean frameless look
window-decoration = none

# Maximize on startup
maximize = true

# Hide tab bar (WezTerm has enable_tab_bar = false)
window-show-tab-bar = never

# ─── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ─── macOS keys ───────────────────────────────────────────────────────────────

# Right ⌥ = compose (keeps ø, ñ, é… via dead keys)
# Left ⌥ = Alt/Meta (for tmux, readline, neovim)
macos-option-as-alt = left

# ─── Scrollback ────────────────────────────────────────────────────────────────
scrollback-limit = 10000000

# ─── Misc ──────────────────────────────────────────────────────────────────────
confirm-close-surface = false
auto-update = off

# ─── Keybinds ──────────────────────────────────────────────────────────────────

# Unbind Ctrl+Space so it passes through to tmux copy mode
keybind = ctrl+space=unbind
